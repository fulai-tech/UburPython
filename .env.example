# 服务
APP_HOST=0.0.0.0
APP_PORT=8080
APP_DEBUG=false

# 功能手板 gRPC（与 HTTP 同进程；明文无鉴权，生产勿对公网裸暴露）
GRPC_HOST=0.0.0.0
GRPC_PORT=50065
GRPC_ENABLED=true

# 量产 gRPC
SOMNI_GRPC_PORT=50064
SOMNI_GRPC_ENABLED=true

# Elasticsearch（功能手板）
ES_NODE=http://localhost:9200
ES_AUDIO_INDEX=somni_audio_materials
ES_TAG_VECTORS_INDEX=somni_audio_tag_dictionary

# 量产 ES（与手板隔离；可填另一节点）
SOMNI_ES_NODE=http://localhost:9201
SOMNI_ES_AUDIO_INDEX=somni_audio_materials
SOMNI_ES_TAG_VECTORS_INDEX=somni_audio_tag_dictionary
SOMNI_ES_SEARCH_EVENTS_INDEX=somni_audio_search_events

# MongoDB（功能手板 Fullive）
MONGO_URI=mongodb://user:password@host:27017/Fullive
MONGO_DB=Fullive

# MongoDB（量产 Somni）
SOMNI_MONGO_URI=mongodb://user:password@host:27017/Somni
SOMNI_MONGO_DB=Somni
# 答卷集合（对齐 BioNode quiz_answers 结构）
SOMNI_MONGO_ANSWERS_COLLECTION=somni_quiz_answers
# 题库集合：GetAnswer 用选项 label 回填答卷 value
SOMNI_MONGO_QUESTIONS_COLLECTION=somni_quiz_questions
# 量产报告相关集合
SOMNI_MONGO_DEVICES_COLLECTION=somni_devices
SOMNI_MONGO_TELEMETRY_COLLECTION=somni_telemetry
SOMNI_MONGO_RECORDS_COLLECTION=somni_records
SOMNI_MONGO_SLEEP_REPORTS_COLLECTION=somni_sleep_reports
SOMNI_MONGO_EVENTS_COLLECTION=somni_events
# GetEvents 会话遥测分桶占比（总时长的百分比，默认 10）
SOMNI_REPORT_SERIES_BUCKET_PERCENT=10

# 检索参数
SIM_THRESHOLD=0.7
# 多路文本检索：厌恶标签与素材内容标签余弦 ≥ 该值则硬剔除
STRONG_DISLIKE_SIM_THRESHOLD=0.85
DEFAULT_TOP_K=10
# 检索步骤 1 是否按 sleep_stage_tags 做 nested 精确过滤
SEARCH_SLEEP_STAGE_FILTER_ENABLED=true
# 同时执行的检索流水线上限
SEARCH_MAX_CONCURRENCY=25

# Embedding（本地量化 ONNX；换模型/维度须重建 ES 并全量重算向量）
EMBEDDING_BACKEND=onnx
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
EMBEDDING_DIM_EN=384
EMBEDDING_ONNX_DIR=models/onnx/bge-small-zh-v1.5-int8
EMBEDDING_ONNX_DIR_EN=models/onnx/bge-small-en-v1.5-int8
# ONNX 会话池：每个会话各加载一份模型进内存；1=省内存串行，>1 提高并发
EMBEDDING_ONNX_POOL_SIZE=1
# 单 session 内 ORT 线程数；池化后建议 1，避免 CPU 过订阅
EMBEDDING_ONNX_INTRA_OP_THREADS=1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_TIMEOUT_SEC=30
EMBEDDING_API_BATCH_SIZE=10

# GetAudio 双路检索（BM25 混合文本 + knn 混合向量）
GET_AUDIO_VECTOR_ENABLED=true
GET_AUDIO_BM25_ENABLED=true
GET_AUDIO_SEARCH_TOP_K=30
GET_AUDIO_KNN_K=50
GET_AUDIO_KNN_NUM_CANDIDATES=150
GET_AUDIO_RRF_K=60
# ES knn _score=(1+cosine)/2；0.80 ≈ 真实余弦 0.60
GET_AUDIO_MIN_VECTOR_SCORE=0.80
# BM25 绝对门槛；默认 0.3，避免 a/的 等弱命中
GET_AUDIO_MIN_BM25_SCORE=0.2
GET_AUDIO_SCORE_CLIFF_RATIO=0.97
# 分路断崖；未设则回退 GET_AUDIO_SCORE_CLIFF_RATIO
GET_AUDIO_BM25_SCORE_CLIFF_RATIO=0.78
GET_AUDIO_KNN_SCORE_CLIFF_RATIO=0.95
GET_AUDIO_HYBRID_REQUIRE_BOTH_LANES=false
GET_AUDIO_RERANK_BY_RELEVANCE=true
GET_AUDIO_LEXICAL_MATCH_ENABLED=true
GET_AUDIO_BM25_QUERY_BLACKLIST=了,的,啊,呢,吧,吗,呀,嘛,哦,嗯,我,你,他,她,它,您,咱,和,与,或,是,在,有,就,还,很,太,最,不,没,也,都,把,被,让,给,从,向,对,比,好,行,可以,好的,随便,你好,在吗,哈哈,呵呵,嗯嗯,a,an,the,i,me,you,and,or,no,yes,ok,hi,lol,omg,idk,wtf,foo,bar,test,car
# 问卷 dislike：描述向量下限 / 与最高分 margin；标签向量 margin；二级标签扩散
GET_AUDIO_DISLIKE_DESC_SIM_FLOOR=0.65
GET_AUDIO_DISLIKE_DESC_SIM_MARGIN=0.06
GET_AUDIO_DISLIKE_TAG_SIM_MARGIN=0.06
GET_AUDIO_DISLIKE_TAG_SPREAD_SIM=0.60
GET_AUDIO_COLOR_NOISE_MUTEX_ENABLED=true

# Mongo → ES 差异同步（服务内每周定时 + 可手动 scripts/sync_es_from_comm.py）
SYNC_ENABLED=true
SYNC_INTERVAL_DAYS=7
SYNC_PAGE_SIZE=100
SYNC_BACKUP_DIR=data/sync_backup
SYNC_BACKUP_FILENAME=somni_audio_materials_backup.json

# 日志（控制台 + 按日文件。公共：logs/YYYY-MM-DD_ubur_log。
# gRPC 按服务拆分：logs/{handboard|somni}/{服务}/YYYY-MM-DD_controller 与 _service）
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION=7 days

# 功能手板 / HTTP 检索缓存（空 REDIS_URL 表示关闭；TTL 自写入起算，命中不续期）
REDIS_URL=redis://127.0.0.1:6379/0
# 量产 Redis（独立实例；空则 GetHot 关闭，不回退 REDIS_URL）
# 本地可另起：redis-server --port 6380 --save "" --appendonly no
SOMNI_REDIS_URL=redis://127.0.0.1:6380/0
# GetHot 热点排行（Redis ZSET + ES 搜索事件索引）
SOMNI_HOT_ENABLED=true
SOMNI_HOT_TOP_N=10
SOMNI_HOT_REDIS_KEY=somni:audio:hot:v1
SOMNI_REDIS_MAX_CONNECTIONS=128
SOMNI_REDIS_CONNECT_TIMEOUT_SEC=2
SOMNI_REDIS_SOCKET_TIMEOUT_SEC=2
# 连接池大小：需 ≥ HTTP 并发峰值，过小会 Too many connections
REDIS_MAX_CONNECTIONS=512
SEARCH_CACHE_MAX_SIZE=2048
SEARCH_CACHE_TTL_SEC=604800
# CUD 后延时重建睡眠阶段候选（秒）；窗口内多次增删改只重建一次
SLEEP_STAGE_CACHE_REWARM_DELAY_SEC=5
